{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:topic-discovery:snapshot:1",
  "title": "Discovery dashboard snapshot v1",
  "type": "object",
  "required": [
    "run",
    "cursor",
    "modules",
    "events"
  ],
  "properties": {
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "status"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
    "cursor": {
      "type": "integer",
      "minimum": 0
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "module_id",
          "status",
          "unit",
          "input_count",
          "output_count",
          "quality"
        ],
        "properties": {
          "module_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "quality": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "status",
                "method",
                "definition_version"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "pending",
                    "partial",
                    "completed",
                    "unknown",
                    "not_applicable",
                    "unavailable"
                  ]
                },
                "numerator": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "denominator": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "sample_size": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "method": {
                  "enum": [
                    "rule",
                    "model",
                    "human",
                    "unknown",
                    "independent_agent_alignment_not_human",
                    "independent_agent_gold_not_human"
                  ]
                },
                "definition_version": {
                  "type": "string"
                },
                "evaluated_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "value": {
                  "type": [
                    "number",
                    "string",
                    "null"
                  ]
                },
                "human_reviewed_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "unknown_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "scope": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "definition": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evaluator_version": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "item_id",
                "status"
              ],
              "properties": {
                "item_id": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "artifact_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "audit": {
                  "type": "object",
                  "properties": {
                    "claim": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "verdict": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "review_status": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "review_note": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "text": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "text"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "completed_snapshot": {
            "type": [
              "object",
              "null"
            ]
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "input_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "output_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "completed_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "failed_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "skipped_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "pending_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "retries": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "urn:topic-discovery:event:1"
      }
    }
  }
}
