{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:topic-discovery:event:1",
  "title": "Discovery metric event v1",
  "type": "object",
  "required": [
    "event_id",
    "sequence",
    "schema_version",
    "run_id",
    "module_id",
    "event_type",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string"
    },
    "module_id": {
      "type": "string"
    },
    "step_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string"
    },
    "received_at": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}
